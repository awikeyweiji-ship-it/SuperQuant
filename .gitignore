# =========================
# Python bytecode / cache
# =========================
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# =========================
# Virtual environments
# =========================
venv/
.venv/
env/
ENV/

# common venv layout on Windows / Linux
Lib/site-packages/
lib/python*/site-packages/
site-packages/
**/site-packages/

# pip metadata folders (often appear if site-packages got committed)
*.dist-info/
**/*.dist-info/
*.egg-info/
**/*.egg-info/
*.data/
**/*.data/

# binary wheels
*.so
*.dll
*.dylib

# =========================
# Streamlit (keep config, ignore secrets)
# =========================
.streamlit/secrets.toml
.streamlit/*.secrets*
.streamlit/*secret*

# =========================
# SuperQuant caches / artifacts
# =========================
.superquant_cache/
*.parquet
*.pkl
*.meta.json
*.cache
*.local.cache
*.log

# If you generate local DB/cache files
*.sqlite
*.db

# =========================
# IDE / OS
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Secrets
# =========================
.env
.env.*

